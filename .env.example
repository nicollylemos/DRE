# ─── Banco MySQL ──────────────────────────────────────────────────────────────
# Copie este arquivo para .env e preencha com seus dados reais
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=sua_senha_aqui
DB_NAME=dre_oaf

# ─── Aplicação ────────────────────────────────────────────────────────────────
# production esconde mensagens de erro técnicas; use development no seu PC
APP_ENV=production
APP_TZ=America/Sao_Paulo

# Por enquanto toda conta criada é administradora. Coloque 0 pra voltar a ter usuário comum.
TODOS_ADMIN=1
