# ─── Banco MySQL ──────────────────────────────────────────────────────────────
# Copie este arquivo para .env e preencha com seus dados reais.
# XAMPP padrão: usuário root e senha vazia (DB_PASS=)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=dre_oaf

# ─── Aplicação ────────────────────────────────────────────────────────────────
# production esconde mensagens de erro técnicas; use development no seu PC
APP_ENV=development
APP_TZ=America/Sao_Paulo

# Só ligue (1) se o site estiver atrás de proxy/Cloudflare que manda X-Forwarded-For.
# Deixar ligado sem proxy permite forjar o IP e furar o limite de tentativas de login.
TRUST_PROXY=0

# ─── Endereço do sistema ──────────────────────────────────────────────────────
# OBRIGATÓRIO em produção para o "Esqueci minha senha" funcionar (é o começo do link do e-mail).
# Ex.: https://financeiro.seudominio.com.br/   (com a subpasta, se tiver: https://seudominio.com.br/dre/)
APP_URL=

# ─── E-mail (Esqueci minha senha) ────────────────────────────────────────────
# Sem MAIL_HOST: no PC (development) o e-mail é salvo em storage/mail/*.eml pra testar;
# em produção usa a função mail() da hospedagem.
# Hostinger: smtp.hostinger.com, porta 465 + ssl (ou 587 + tls), com uma conta de e-mail do domínio.
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=ssl
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME="OAF Controle Financeiro"

# ─── LGPD (aparece no Termo de uso e na Política de privacidade) ─────────────
LGPD_CONTROLADOR="OAF Consultoria Empresarial"
LGPD_CNPJ=
# E-mail para pedidos de titulares (acesso, correção, exclusão de dados)
LGPD_EMAIL=

# ─── Notas fiscais ───────────────────────────────────────────────────────────
# CNPJ da própria empresa: ajuda a saber se o XML é nota de entrada ou de saída.
# Opcional — sem ele o sistema deduz pelas notas já cadastradas.
EMPRESA_CNPJ=
