# ─── Banco MySQL ──────────────────────────────────────────────────────────────
# Copie este arquivo para .env e preencha com seus dados reais.
# XAMPP padrão: usuário root e senha vazia (DB_PASS=)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=dre_oaf

# ─── Aplicação ────────────────────────────────────────────────────────────────
# production esconde mensagens de erro técnicas; use development no seu PC
APP_ENV=development
APP_TZ=America/Sao_Paulo

# Só ligue (1) se o site estiver atrás de proxy/Cloudflare que manda X-Forwarded-For.
# Deixar ligado sem proxy permite forjar o IP e furar o limite de tentativas de login.
TRUST_PROXY=0

# ─── LGPD (aparece no Termo de uso e na Política de privacidade) ─────────────
LGPD_CONTROLADOR="OAF Consultoria Empresarial"
LGPD_CNPJ=
# E-mail para pedidos de titulares (acesso, correção, exclusão de dados)
LGPD_EMAIL=

# ─── Notas fiscais ───────────────────────────────────────────────────────────
# CNPJ da própria empresa: ajuda a saber se o XML é nota de entrada ou de saída.
# Opcional — sem ele o sistema deduz pelas notas já cadastradas.
EMPRESA_CNPJ=
