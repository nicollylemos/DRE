# DRE System (PHP MVC) — Apache / XAMPP / Hostinger
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Bloqueia acesso direto a código, configuração e arquivos internos
  RewriteRule ^(app|storage|docs)(/|$) - [F,L]
  RewriteRule (^|/)\.(env|git|htaccess) - [F,L]
  RewriteRule \.(sql|md|lock|log)$ - [F,L]
  RewriteRule ^router\.php$ - [F,L]

  # Arquivo que existe (css, js, imagens, uploads) é servido direto;
  # todo o resto (páginas e /api/*) vai pro front controller.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

# Uploads de até 20 MB (se a hospedagem permitir sobrescrever via .htaccess)
<IfModule mod_php.c>
  php_value upload_max_filesize 20M
  php_value post_max_size 22M
</IfModule>
<IfModule mod_php8.c>
  php_value upload_max_filesize 20M
  php_value post_max_size 22M
</IfModule>
