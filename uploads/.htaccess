# Nada aqui dentro pode ser executado como script — só servido como arquivo.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py
RemoveType .php .phtml .phar
<FilesMatch "\.(php\d?|phtml|phar|cgi|pl|py|sh|html?|svg|js)$">
  Require all denied
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
